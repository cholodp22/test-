# telegram
BOT_TOKEN=
CHAT_ID=
ADMIN_IDS=

# twitter / x (twscrape)
# одного из путей достаточно:
#   путь A — логин/пароль + email (twscrape сам ходит на почту за кодами):
X_LOGIN=
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=
#   путь B — готовые cookies из браузера (без email):
#   формат: "auth_token=...; ct0=..."
#   взять в dev tools → application → cookies → x.com
X_COOKIES=

# poller
POLL_INTERVAL_SECONDS=120
TWEETS_PER_POLL=20

# storage
DB_PATH=bot.db
TWSCRAPE_DB_PATH=accounts.db
