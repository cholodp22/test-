# telegram
# CHAT_ID — единственный чат, где бот реагирует и куда шлёт твиты.
BOT_TOKEN=
CHAT_ID=

# twitter / x — авторизация по cookies технического аккаунта
# формат: "auth_token=...; ct0=..."
# взять в dev tools → application → cookies → x.com
X_COOKIES=

# (опционально, не используется при cookie-авторизации)
X_LOGIN=
X_PASSWORD=

# poller
# при большом числе аккаунтов держи интервал >=180 сек,
# иначе x graphql вернёт 429 (rate limit).
POLL_INTERVAL_SECONDS=180
TWEETS_PER_POLL=20
# пауза между запросами к x в одном цикле опроса (защита от 429).
REQUEST_DELAY_SECONDS=2.5

# storage
DB_PATH=bot.db
