# telegram
BOT_TOKEN=
CHAT_ID=
ADMIN_IDS=

# twitter / x — авторизация по cookies технического аккаунта
# формат: "auth_token=...; ct0=..."
# взять в dev tools → application → cookies → x.com
X_COOKIES=

# (опционально, не используется при cookie-авторизации)
X_LOGIN=
X_PASSWORD=

# poller
POLL_INTERVAL_SECONDS=120
TWEETS_PER_POLL=20

# storage
DB_PATH=bot.db
